    {
      "id": "claim_cd0a247957e0410fa477e01a4194a980",
      "statement": "Message length is measured by message_units as len(text.encode(\"utf-16-le\")) // 2 — UTF-16 code units, the way Telegram counts — against MESSAGE_BUDGET (3800) beneath PLATFORM_LIMIT (4096), each trimmed section carrying the visible TRIM_MARKER (\"… [trimmed]\"); the inbox bounds an owner reply's length with the same expression.",
      "evidence": [
        {
          "resource": "repo://src/paraphe/adapters/telegram.py#L12-L34",
