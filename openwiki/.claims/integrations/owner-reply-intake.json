    {
      "id": "claim_e2b0d58a1af84b6682bec2beb337e152",
      "statement": "The reply door hands the resolved card's own version, the message identity it was found by and responded_via=\"telegram-reply\" to the same _claim_locked method a tap reaches, which makes stale_version, stale_message, invalid_message and invalid_choice unreachable on the reply path — staleness surfaces as unknown at the lookup instead — while not_owner, expired, cancelled, already_tapped and invalid_answer remain reachable.",
      "evidence": [
        {
          "resource": "repo://src/paraphe/inbox/__init__.py#L520-L548",
          "version": "repo-lines-v1:sha256:50aa0f27877bab20b951863055c741f9c676c744fb39a28b1297e97afd9bbe0f:"
