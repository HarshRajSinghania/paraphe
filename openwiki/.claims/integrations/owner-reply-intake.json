    {
      "id": "claim_4a54bfff77f3407db0fe394884752733",
      "statement": "An accepted reply writes exactly the lifecycle a same-moment tap writes minus the choice — state tapped, response_text holding the owner's words, responded_at, responded_via telegram-reply, the message identity with telegram_keyboard_attached true, and no response_choice — followed in order by the durable _save, _notify_waiters so parked calls return, remember_message on the port, and _request_strip.",
      "evidence": [
        {
          "resource": "repo://src/paraphe/inbox/__init__.py#L615-L638",
          "version": "repo-lines-v1:sha256:ee2c975aba3d54ea86ba584a188209b6f31ca8d73e6af3fef5dd837faeeb059f:"
