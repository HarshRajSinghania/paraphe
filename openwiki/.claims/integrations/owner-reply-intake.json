    {
      "id": "claim_a2ca7e9262984dca8bb2f21235946ab0",
      "statement": "Because the ladder refreshes expiry before the state check, a reply to an open card past expires_at first writes the card as expired (waking waiters and stripping) and is then refused expired; a reply to a cancelled card is refused cancelled, and a reply to a card that already has an answer is refused already_tapped with no new card state written — only the strip is re-issued — so the first answer stands.",
      "evidence": [
        {
          "resource": "repo://src/paraphe/inbox/__init__.py#L568-L580",
          "version": "repo-lines-v1:sha256:2f2d06f1b12ad905192022414a7d7725d425a0f480083ddcb0d395b5b3729abb:"
