  "claims": [
    {
      "id": "claim_1efc8974aff14603894f894131aaaac8",
      "statement": "TelegramAdapter.handle_update treats a private-chat message from the owner whose reply_to_message carries a positive integer message_id as a reply attempt: it calls _on_reply with the chat id, the replied-to message id and the text, and returns an empty list, so nothing is ever sent back to Telegram; a non-private or foreign chat, a non-owner sender, a non-string text, or a reply target without a positive message id is dropped before any claim runs.",
      "evidence": [
        {
          "resource": "repo://src/paraphe/adapters/telegram.py#L367-L403",
          "version": "repo-lines-v1:sha256:41d9e55dc958dd5a2e1a60f678379175e42a193b40f8e6537a8d07ecfddf7175:"
        }
      ]
    },
    {
      "id": "claim_86e8203773084871a2fb3c55583aacb0",
      "statement": "Inbox.claim_reply requires both from_id and chat_id to equal the inbox's owner_telegram_id and then resolves the target card with _card_by_telegram_message, a scan of the loaded card state for a card whose stored telegram_chat_id and telegram_message_id match the replied-to identity; a replied-to message no loaded card records resolves to nothing and is refused ClaimRefused(\"unknown\").",
      "evidence": [
        {
          "resource": "repo://src/paraphe/inbox/__init__.py#L520-L554",
          "version": "repo-lines-v1:sha256:95b2b6caccda273a52d1d8afa23831a151f3786e9a022b3ff45788a0ad729d67:"
        }
      ]
    },
    {
      "id": "claim_21d6abb237dd4c1bb37ad82e3af91ecc",
      "statement": "Reply resolution survives a process restart because the binding lives in the card's stored telegram_chat_id/telegram_message_id columns, written by record_telegram_message at send time, and _ensure_store loads every card row into the inbox on first use after construction — the adapter's in-memory location map is never consulted for resolution.",
      "evidence": [
        {
          "resource": "repo://src/paraphe/inbox/__init__.py#L1169-L1190",
          "version": "repo-lines-v1:sha256:679c45c8ca8ead8a7492f437455d9d995bba325d52c355fbc996763efce7cdf1:"
