    {
      "id": "claim_67fab9f1287e4a7a99ea40129045a97f",
      "statement": "Reply text is recorded verbatim with surrounding whitespace preserved and no choice index, while blank or whitespace-only text and text longer than 4096 UTF-16 units are refused invalid_answer, a refusal the adapter swallows.",
